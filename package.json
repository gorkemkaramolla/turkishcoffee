{
  "name": "turkishcoffee",
  "version": "1.1.1",
  "description": "Personal React UI component library \u2014 Tailwind v4, Radix primitives, RSC-aware.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./form": {
      "types": "./dist/components/form/index.d.ts",
      "default": "./dist/components/form/index.js"
    },
    "./data-table": {
      "types": "./dist/components/data-table/index.d.ts",
      "default": "./dist/components/data-table/index.js"
    },
    "./theme.css": "./dist/styles/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && mkdir -p dist/styles && cp src/styles/theme.css dist/styles/theme.css",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "check-exports": "publint && attw --pack . --profile esm-only --exclude-entrypoints theme.css",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^3.0.2",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "jsdom": "^27.0.0",
    "publint": "^0.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.87.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gorkemkaramolla/turkishcoffee.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
